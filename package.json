{
  "name": "pi-total-recall",
  "version": "1.9.2",
  "description": "Complete context stack for pi — persistent memory, session history search, and local knowledge search in one install.",
  "keywords": [
    "pi-package",
    "extension",
    "memory",
    "context",
    "session-search",
    "knowledge-search",
    "semantic-search"
  ],
  "author": "Sam Painter",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samfoy/pi-total-recall.git"
  },
  "homepage": "https://github.com/samfoy/pi-total-recall#readme",
  "bugs": {
    "url": "https://github.com/samfoy/pi-total-recall/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test --import tsx test/*.test.ts",
    "check:pack": "node scripts/check-pack.mjs"
  },
  "dependencies": {
    "@samfp/pi-memory": "^1.6.1",
    "pi-knowledge-search": "^1.3.8",
    "pi-session-search": "^1.6.1"
  },
  "bundleDependencies": [
    "@samfp/pi-memory",
    "pi-session-search",
    "pi-knowledge-search"
  ],
  "devDependencies": {
    "tsx": "^4.23.15",
    "typebox": "^1.3.34"
  },
  "pi": {
    "extensions": [
      "node_modules/@samfp/pi-memory/dist/index.js",
      "node_modules/pi-session-search/dist/index.js",
      "node_modules/pi-knowledge-search/dist/index.js"
    ],
    "skills": [
      "node_modules/pi-session-search/skills"
    ]
  }
}
